{
    "name": "carsdotcom/php-request-class",
    "type": "library",
    "description": "Structure the logic around Guzzle API requests into object-oriented classes",
    "keywords": [
        "php",
        "laravel",
        "guzzle"
    ],
    "license": "MIT",
    "require": {
        "carsdotcom/laravel-json-schema": "^v1.0 || v2.0 || v2.1",
        "ext-simplexml": "*",
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "laravel/framework": "^9.19 || ^10.0 || ^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "nunomaduro/collision": "^6.1|7.*|8.*",
        "orchestra/testbench": "7.*|8.*|9.*",
        "phpstan/phpstan": "^1.8",
        "phpunit/phpunit": "~8.0|~9.0|^10.5",
        "squizlabs/php_codesniffer": "^3.7",
        "timacdonald/log-fake": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Carsdotcom\\ApiRequest\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Carsdotcom\\ApiRequest\\ApiRequestProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
